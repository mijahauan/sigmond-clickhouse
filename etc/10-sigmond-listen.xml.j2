<?xml version="1.0"?>
<!--
  sigmond-managed listen address drop-in.
  Rendered from /opt/git/sigmond/clickhouse/etc/10-sigmond-listen.xml.j2
  using SIGMOND_CLICKHOUSE_LISTEN from /etc/sigmond/coordination.env.

  - "loopback" (default): bind to 127.0.0.1 only.  Local clients only.
  - "lan":                bind to 0.0.0.0.  LAN-shared mode.  Requires
                          a non-default user/password (see
                          /etc/sigmond/secrets/clickhouse-sigmond.pass).

  Do not edit this file directly; sigmond will overwrite it on `smd apply`.
  Override behavior via [storage.clickhouse] in coordination.toml.
-->
<clickhouse>
{%- if listen == "lan" %}
    <listen_host>0.0.0.0</listen_host>
{%- else %}
    <listen_host>127.0.0.1</listen_host>
{%- endif %}
</clickhouse>
